---
import { site, url } from '../data/site';

interface Props {
  variant: 'home' | 'case';
}

const { variant } = Astro.props;
const home = url('');
---

<header class="header" data-header>
  <div class="header__inner container">
    {
      variant === 'home' ? (
        <a class="header__logo" href={home}>
          <span class="header__logo-full">{site.name}</span>
          <span class="header__logo-short" aria-hidden="true">{site.shortName}</span>
        </a>
      ) : (
        <a class="header__link" href={`${home}#projects`}>← Back to projects</a>
      )
    }

    <nav class="header__nav" aria-label="Main">
      {
        variant === 'home' && (
          <>
            <a class="header__link" href="#projects">Projects</a>
            <a class="header__link" href="#about">About me</a>
          </>
        )
      }
      <a class="btn btn--primary header__cta" href="#contacts">Hire me</a>
    </nav>

    {
      variant === 'home' && (
        <button class="header__menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
          Menu
        </button>
      )
    }
  </div>
</header>

{
  variant === 'home' && (
    <div class="menu" id="mobile-menu" hidden data-menu>
      <button class="menu__close" type="button" data-menu-close>Close</button>
      <nav class="menu__links" aria-label="Mobile">
        <a href={home} data-menu-link>{site.name}</a>
        <a href="#projects" data-menu-link>Projects</a>
        <a href="#about" data-menu-link>About me</a>
      </nav>
      <a class="btn menu__cta" href="#contacts" data-menu-link>Hire me</a>
    </div>
  )
}

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    transition:
      background-color 0.3s ease,
      backdrop-filter 0.3s ease;
  }
  .header.is-scrolled {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }
  .header__logo,
  .header__link {
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .header__logo:hover,
  .header__link:hover {
    opacity: 0.7;
  }
  .header__logo-short {
    display: none;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .header__menu-btn {
    display: none;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: 500 16px/1.5 var(--font-body);
    cursor: pointer;
  }

  @media (max-width: 809px) {
    .header__logo-full {
      display: none;
    }
    .header__logo-short {
      display: inline;
    }
    .header__nav .header__link {
      display: none;
    }
    .header__nav:has(+ .header__menu-btn) {
      display: none;
    }
    .header__menu-btn {
      display: block;
    }
    .header__cta {
      padding: 6px 16px;
      border-radius: var(--radius-sm);
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    padding: 16px;
    background: var(--white);
    color: var(--black);
    animation: menu-in 0.3s var(--ease);
  }
  .menu[hidden] {
    display: none;
  }
  .menu__close {
    align-self: flex-end;
    padding: 4px 0;
    border: 0;
    background: none;
    color: inherit;
    font: 500 16px/1.5 var(--font-body);
    cursor: pointer;
  }
  .menu__links {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 24px;
  }
  .menu__links a {
    font-size: 24px;
    text-decoration: none;
  }
  .menu__cta {
    margin-top: auto;
    width: 100%;
    min-height: 56px;
    background: var(--black);
    color: var(--white);
  }
  .menu__cta:hover {
    background: rgba(8, 8, 8, 0.8);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (menu && openBtn && closeBtn) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      (open ? closeBtn : openBtn).focus();
    };
    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });
  }
</script>
